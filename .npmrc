# .npmrc — settings applied to every `npm install` in this project.
#
# Goal: make `npm install` succeed predictably on first try even when
# the developer is behind a slow link or inside mainland China, so that
# `node_modules/electron/dist/electron.exe` (the bit that takes ~100 MB
# to download) is reached instead of being silently skipped.

# 1) Use the npmmirror.com Electron mirror first; fall back to GitHub
#    (the @electron/get client retries automatically on mirror failure).
#    Setting `ELECTRON_MIRROR` is the official, supported way and does
#    NOT require patching any code.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 2) Bump per-fetch timeouts so a slow link doesn't masquerade as an
#    install hang. Default `fetch-timeout` is 60s; we triple it.
fetch-timeout=180000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# 3) Honor `engine-strict` later via `npm install --engine-strict`. We
#    don't force it here because Node 18/20/22 all work; this just lets
#    npm note a warning if someone's on a wildly unsupported Node.

# 4) Forbid optional native builds from silently skipping on a Windows
#    MSVC-less box (`--no-optional` would; we want optional on, so we
#    keep the default and instead surface failures via scripts/install.js).

# 5) Prefer a stable, reproducible install tree:
fund=false
audit=false
package-lock=true
