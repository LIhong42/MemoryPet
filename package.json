{
  "name": "memory-pet",
  "version": "0.1.0",
  "description": "MemoryPet — local-first relationship & reminders with a desktop pet",
  "main": "main/main.js",
  "author": "MemoryPet",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "dev": "node scripts/run-electron.js . --dev",
    "prebuild": "node scripts/prebuild-extract-winCodeSign.js",
    "build": "npm run prebuild && electron-builder",
    "build:dir": "npm run prebuild && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "lunar-javascript": "^1.6.13",
    "pdfkit": "^0.15.1",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.memorypet.app",
    "productName": "MemoryPet",
    "files": [
      "main/**/*",
      "pet/**/*",
      "src/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**",
      "!node_modules/.bin/**",
      "!node_modules/@electron/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/electron-builder-lib/**",
      "!node_modules/jsdom/**",
      "!node_modules/7zip-bin/**",
      "!node_modules/app-builder/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/dmg-license/**",
      "!node_modules/macos-alias/**",
      "!node_modules/{electron,electron-builder,jsdom,7zip-bin}/**"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MemoryPet"
    },
    "directories": {
      "output": "dist"
    }
  }
}
